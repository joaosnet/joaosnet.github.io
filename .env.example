# Build and public imports need no secrets and do NOT load .env.
# For a private-preview command only, set this in the process environment.
# Use a fine-grained token limited to the explicitly selected repositories,
# with only read access to the necessary repository metadata.
PRIVATE_REPOS_TOKEN=

# Public runtime settings live in content/site.json.
# Keep analytics_endpoint empty until the NEW collector has been validated.
# Google SHEET_ID is a private Apps Script property, never a browser setting.
