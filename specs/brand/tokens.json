{
  "$comment": "Canonical brand tokens. Mirrored as CSS custom properties at the top of assets/css/portfolio.css; change both together.",
  "font": {
    "sans": "Outfit, system-ui, -apple-system, sans-serif",
    "mono": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
  },
  "scale": {
    "ratio": 1.25,
    "base": "1rem",
    "steps": {
      "-2": "0.64rem",
      "-1": "0.8rem",
      "0": "1rem",
      "1": "1.25rem",
      "2": "1.563rem",
      "3": "1.953rem",
      "4": "2.441rem",
      "5": "3.052rem"
    }
  },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "6": "24px", "8": "32px", "12": "48px", "16": "64px" },
  "color": {
    "$comment": "Accent hues derive from --theme-hue (default 192) so the visitor palette picker keeps working.",
    "dark": {
      "bg": "#080b10",
      "surface": "#10151d",
      "surface-2": "#141c27",
      "text": "#f2f5fa",
      "muted": "#a2afc1",
      "line": "#233041",
      "cyan": "hsl(hue 85% 68%)",
      "violet": "hsl(hue+68 85% 81%)",
      "mint": "hsl(hue-37 65% 72%)"
    },
    "light": {
      "bg": "#f7f9fc",
      "surface": "#fff",
      "surface-2": "#eaf0f6",
      "text": "#172033",
      "muted": "#506078",
      "line": "#d3deeb",
      "cyan": "hsl(hue 90% 25%)",
      "violet": "hsl(hue+68 47% 49%)",
      "mint": "hsl(hue-37 70% 26%)"
    }
  },
  "border": { "subtle": "1px solid var(--line)" },
  "motion": {
    "ease-out-expo": "cubic-bezier(0.16, 1, 0.3, 1)",
    "duration": { "1": "160ms", "2": "320ms", "3": "640ms" },
    "reduced": "All durations collapse to 0ms under prefers-reduced-motion: reduce."
  },
  "annotations": {
    "fig. 01 · kernel": "#services",
    "fig. 02 · bus": "#process",
    "fig. 03 · silicon": "#projects",
    "fig. 04 · compiler": "#published (lab)"
  }
}
